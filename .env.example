# Copy to .env and fill in. .env is gitignored — never commit it.

# Signing key for session cookies. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GTD_SESSION_SECRET=

# Path to the SQLite database file (relative paths resolve from the project root).
GTD_DB_PATH=gtd.db

# Directory markdown exports are written to.
GTD_EXPORT_DIR=exports

# Set to true ONLY when serving over HTTPS — marks the session cookie Secure,
# which prevents it being sent over plain http (and would break local http testing).
GTD_SECURE_COOKIES=false

# Session lifetime in seconds (default: 30 days).
GTD_SESSION_MAX_AGE=2592000

# Shared secret for the token-authed capture API (POST /api/capture), used later
# by the Discord bot / other capture surfaces. Leave blank to disable that endpoint.
GTD_CAPTURE_TOKEN=

# Refuse to serve anyone but this machine. Set true on work machines and any
# instance that must never be reachable remotely (see ADR-008/ADR-010).
# When true: `gtd serve` refuses to bind a non-loopback interface, AND the app
# rejects any request whose peer isn't on this machine — so the guarantee holds
# even if someone starts uvicorn directly with the wrong --host.
GTD_LOCAL_ONLY=false

# Host/port used by `gtd serve`. GTD_LOCAL_ONLY overrides the host.
GTD_HOST=127.0.0.1
GTD_PORT=8765

# ── Backups ─────────────────────────────────────────────────────────────────
# Where verified snapshots are written locally.
GTD_BACKUP_DIR=backups
# How many to retain locally. Older ones are pruned after each run.
GTD_BACKUP_KEEP=14
# Offsite target as user@host:/path — a machine you own, over Tailscale.
# Snapshots are copied here after passing their integrity check.
GTD_BACKUP_REMOTE=
# SSH key used for that copy. Dedicated to backups, not your everyday key.
GTD_BACKUP_IDENTITY=~/.ssh/gtd_backup
